<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.CHANGE_NETWORK_STATE"
        tools:node="remove" />
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@drawable/qa_launcher_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/qa_launcher_icon"
        android:usesCleartextTraffic="false"
        tools:replace="android:allowBackup,android:fullBackupContent,android:icon,android:label,android:roundIcon,android:usesCleartextTraffic" />
</manifest>
